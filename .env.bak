# ==============================================================================
# Website Change Discord Watcher - 환경 설정 예시
# ==============================================================================
# 사용법: 이 파일을 .env로 복사한 후 필요한 값을 입력하세요.
#   cp .env.bak .env

# [필수] Discord 웹훅 URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE"

# [선택] 프로젝트 루트 경로 (미설정 시 저장소 루트 자동 감지)
# systemd 서비스 생성 시 WorkingDirectory로 사용됩니다.
# PROJECT_DIR=/path/to/website-change-discord

# [선택] 주요 파일 경로 (상대 경로 지정 시 PROJECT_DIR 기준으로 해석됨)
CONFIG_FILE=config.yaml
DB_FILE=hashes.db
LOG_FILE=app.log

# [선택] 실행 주기 및 스케줄 설정
# 1. 데몬 모드 실행 주기 (분 단위, 기본값: 60분)
DAEMON_INTERVAL_MINUTES=60
# 또는 시간 단위로 지정 가능 (예: DAEMON_INTERVAL_HOURS=1)
# DAEMON_INTERVAL_HOURS=1

# 2. config.yaml의 각 사이트에 interval_hours가 없을 때 사용할 기본 주기 (시간 단위, 기본값: 24시간)
DEFAULT_INTERVAL_HOURS=24

# 3. systemd Timer 주기 (기본값: hourly)
# 예: hourly (매시 정각), daily (매일 자정), *:0/30 (30분마다), *:0/15 (15분마다)
SYSTEMD_TIMER_ON_CALENDAR=hourly

# [선택] 타임아웃 설정 (초 단위)
REQUEST_TIMEOUT=15
DISCORD_TIMEOUT=10

# [선택] 로그 회전 설정
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
