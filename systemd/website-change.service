[Unit]
Description=Website Change Notification Service
After=network.target

[Service]
Type=oneshot
# Note: Can be automatically configured for your environment via 'uv run setup_systemd'
WorkingDirectory=%h/website-change-discord
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/env uv run monitor

[Install]
WantedBy=default.target
